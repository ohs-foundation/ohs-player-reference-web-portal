{
  "id": "ohs",
  "realm": "ohs",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "id": "role-admin", "name": "admin", "description": "Administrator" },
      {
        "id": "role-care-team-manager",
        "name": "care-team-manager",
        "description": "Care team manager"
      }
    ]
  },
  "defaultDefaultClientScopes": [],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "ohs-player-web",
      "name": "ohs-player-web",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "user.attribute": "foo",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "manager-user",
      "enabled": true,
      "emailVerified": true,
      "email": "manager@example.com",
      "credentials": [{ "type": "password", "value": "manager", "temporary": false }],
      "realmRoles": ["care-team-manager"]
    }
  ]
}
