{
  "id": "ohs",
  "realm": "ohs",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "ohs",
  "roles": {
    "realm": [
      { "id": "role-admin", "name": "admin", "description": "Administrator" },
      {
        "id": "role-care-team-manager",
        "name": "care-team-manager",
        "description": "Care team manager"
      },
      { "name": "location-hierarchy.view", "description": "View the location hierarchy tree" },
      { "name": "bulk-import.manage", "description": "Manage bulk CSV imports (locations, users, orgs)" },
      { "name": "users.manage", "description": "Manage users via the gateway /api/users (view+edit+delete)" },
      { "name": "groups.manage", "description": "Manage groups via the gateway /api/groups (view+edit+manage)" },
      { "name": "roles.view", "description": "View roles via the gateway /api/roles" },
      { "name": "practitioner-details.view", "description": "View practitioner details via the gateway /api/practitioner-details" }
    ]
  },
  "defaultDefaultClientScopes": [],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "ohs-player-web",
      "name": "ohs-player-web",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "user.attribute": "foo",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "ohs-backend",
      "name": "OHS Backend Service Account",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ohs-backend-dev-secret",
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["admin", "location-hierarchy.view", "bulk-import.manage", "users.manage", "groups.manage", "roles.view", "practitioner-details.view"]
    },
    {
      "username": "manager-user",
      "enabled": true,
      "emailVerified": true,
      "email": "manager@example.com",
      "credentials": [{ "type": "password", "value": "manager", "temporary": false }],
      "realmRoles": ["care-team-manager", "location-hierarchy.view"]
    },
    {
      "username": "service-account-ohs-backend",
      "enabled": true,
      "serviceAccountClientId": "ohs-backend",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "manage-realm", "view-realm"]
      }
    }
  ]
}
