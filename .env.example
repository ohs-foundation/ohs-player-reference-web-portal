# Reference app — copy to `.env` and adjust for your environment
# Every VITE_* value below is a build-time fallback. The configuration document served at runtime
# (apps/ohs-player-web/public/portal-config.json, see docs/DEPLOYMENT.md) wins for any field it sets;
# these values apply only to the fields it leaves out, or when it is missing or invalid.
# Same-origin via the Vite dev proxy: /fhir → HAPI (VITE_DEV_FHIR_TARGET), /api → gateway (VITE_DEV_API_TARGET).
# Custom /api/* endpoints have no CORS, so the SPA must call them same-origin; FHIR reads skip the gateway access-checker.
# Fallback for the document's `fhirBaseUrl`.
VITE_FHIR_BASE_URL=http://localhost:5173/fhir
# Dev proxy targets (vite.config.ts). Override if HAPI / the gateway run elsewhere. Not part of the document.
VITE_DEV_FHIR_TARGET=http://localhost:8080
VITE_DEV_API_TARGET=http://localhost:8180
# Realm `ohs` demo users (see infra/keycloak/ohs-realm.json): admin-user/admin, manager-user/manager.
# Docker Compose KC_BOOTSTRAP_ADMIN_* is only for the Keycloak admin console, not app sign-in.
# Fallbacks for the document's `oidcIssuer`, `clientId` and `fhirVersion`.
VITE_OIDC_ISSUER=http://localhost:8090/realms/ohs
VITE_CLIENT_ID=ohs-player-web
VITE_FHIR_VERSION=R4

# Feature flags (build-time fallbacks for the document's `flags`, one per key)
VITE_FLAG_USER_MGMT=true
VITE_FLAG_LOCATION_MGMT=true
VITE_FLAG_CARE_TEAMS=true
VITE_FLAG_DASHBOARD=true
VITE_FLAG_ORG_MGMT=true
VITE_FLAG_SETUP_WIZARD=true
VITE_FLAG_FHIR_VIEWER=true

# Optional: alternate theme (reference app)

# Questionnaire bundle variant (see src/questionnaires/registry.ts); default: default
# Fallback for the document's `questionnaireVariant`.
# VITE_QUESTIONNAIRE_VARIANT=default
